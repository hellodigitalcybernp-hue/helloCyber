<section class="section" style="padding-bottom:0;">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow"><%- icon('layers') %> Blog & Guides</span>
      <h1><%= activeCategory ? activeCategory + ' Articles' : 'Blog & Guides' %></h1>
      <p>Step-by-step help for Nepal passport forms, NID correction, citizenship, driving licence and other government paperwork.</p>
    </div>

    <form method="GET" action="/blog" style="max-width:420px; margin:0 auto 20px; display:flex; gap:8px;">
      <input type="text" name="q" value="<%= q %>" placeholder="Search articles..." style="flex:1; padding:10px 14px; border-radius:10px; border:1px solid var(--border); font-family:var(--font-body);" />
      <button type="submit" class="btn btn-dark">Search</button>
    </form>

    <div class="filter-row">
      <a href="/blog" class="filter-pill <%= !activeCategory ? 'active' : '' %>">All Articles</a>
      <% categories.forEach(function(c){ %>
        <a href="/blog?category=<%= encodeURIComponent(c) %>" class="filter-pill <%= activeCategory === c ? 'active' : '' %>"><%= c %></a>
      <% }) %>
    </div>
  </div>
</section>

<section class="section" style="padding-top:0;">
  <div class="container">
    <% if (articles.length === 0) { %>
      <div class="a-empty" style="background:#fff; border-radius:14px; border:1px solid #E3E9F0; padding:40px; text-align:center;">
        <p>No articles found<% if (q) { %> for "<%= q %>"<% } %>.</p>
      </div>
    <% } else { %>
      <div class="service-grid">
        <% articles.forEach(function(a){ %>
          <a href="/blog/<%= a.slug %>" class="service-card" style="text-decoration:none; color:inherit;">
            <span class="badge-category"><%= a.category %></span>
            <% if (a.coverImage) { %>
              <img src="<%= a.coverImage %>" alt="<%= a.title %>" style="width:100%; height:150px; object-fit:cover; border-radius:10px; margin-bottom:14px;" />
            <% } else { %>
              <div class="service-icon"><%- icon('file-text') %></div>
            <% } %>
            <h3><%= a.title %></h3>
            <p class="desc"><%= a.excerpt %></p>
            <div class="service-meta">
              <span><%- icon('clock') %> <%= new Date(a.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></span>
            </div>
          </a>
        <% }) %>
      </div>

      <% if (totalPages > 1) { %>
        <div style="display:flex; justify-content:center; gap:8px; margin-top:32px; flex-wrap:wrap;">
          <% for (let p = 1; p <= totalPages; p++) { %>
            <a href="/blog?page=<%= p %><%= activeCategory ? '&category=' + encodeURIComponent(activeCategory) : '' %><%= q ? '&q=' + encodeURIComponent(q) : '' %>"
               class="filter-pill <%= p === page ? 'active' : '' %>"><%= p %></a>
          <% } %>
        </div>
      <% } %>
    <% } %>

    <%- include('partials/ad-slot') %>
  </div>
</section>