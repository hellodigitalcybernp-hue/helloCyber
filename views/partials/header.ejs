<header class="site-header">
  <div class="nav-wrap">
  <a href="/" class="brand">
    <img src="/image/hellocyber.jpeg" alt="HelloDigitalCyber Logo" class="brand-logo">
    <span><%= (siteSettings && siteSettings.siteName) || 'HelloDigitalCyber' %></span>
  </a>
    <nav class="nav-links" id="navLinks">
      <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Home</a>
      <a href="/services" class="<%= currentPath.startsWith('/services') ? 'active' : '' %>">Services</a>
      <a href="/about" class="<%= currentPath === '/about' ? 'active' : '' %>">About</a>
      <a href="/contact" class="<%= currentPath === '/contact' ? 'active' : '' %>">Contact</a>
    </nav>
    <div class="nav-actions">
      <a href="/contact" class="btn btn-primary btn-sm hide-mobile"><span class="hide-mobile">Get Help Now</span></a>
      <button class="nav-toggle" id="navToggle" aria-label="Toggle menu">&#9776;</button>
    </div>
  </div>
</header>
