<!-- Snake Game Trigger -->
<section class="section" style="padding-top:0;">
  <div class="container" style="text-align:center;">
    <span class="eyebrow"><%- icon('gamepad-2') %> While You Wait</span>
    <div style="margin-top:10px;">
      <button id="openSnakeGame" type="button" class="btn btn-primary">🎮 Play Snake</button>
    </div>
  </div>
</section>

<!-- Snake Game Modal -->
<div id="snakeModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.75); z-index:9999; align-items:center; justify-content:center;">
  <div style="background:#0f172a; border-radius:12px; padding:20px; max-width:420px; width:92%; text-align:center; position:relative;">
    <button id="closeSnakeGame" type="button" style="position:absolute; top:8px; right:12px; background:none; border:none; color:#fff; font-size:1.5rem; cursor:pointer;">&times;</button>
    <h3 style="color:#fff; margin-bottom:10px;">Snake</h3>
    <div style="color:#94a3b8; font-size:0.85rem; margin-bottom:10px;">Score: <span id="snakeScore">0</span></div>

    <canvas id="snakeCanvas" width="320" height="320" style="background:#1e293b; border-radius:8px; max-width:100%; touch-action:none;"></canvas>

    <div id="snakeGameOver" style="display:none; color:#f87171; margin-top:8px; font-weight:bold;">Game Over! Tap Restart.</div>

    <div style="margin-top:12px; display:flex; justify-content:center; gap:8px;">
      <button id="snakeRestart" type="button" class="btn btn-primary" style="padding:6px 14px; font-size:0.85rem;">Restart</button>
    </div>

    <!-- Mobile controls -->
    <div style="margin-top:14px; display:grid; grid-template-columns:repeat(3,44px); grid-template-rows:repeat(2,44px); gap:6px; justify-content:center;">
      <div></div>
      <button type="button" class="snakeDir" data-dir="up" style="grid-column:2;">▲</button>
      <div></div>
      <button type="button" class="snakeDir" data-dir="left">◀</button>
      <button type="button" class="snakeDir" data-dir="down">▼</button>
      <button type="button" class="snakeDir" data-dir="right">▶</button>
    </div>
  </div>
</div>

<style>
  .snakeDir {
    background:#334155; color:#fff; border:none; border-radius:8px;
    font-size:1rem; cursor:pointer;
  }
  .snakeDir:active { background:#475569; }
</style>

<script>
(function () {
  const openBtn = document.getElementById('openSnakeGame');
  const closeBtn = document.getElementById('closeSnakeGame');
  const modal = document.getElementById('snakeModal');
  const canvas = document.getElementById('snakeCanvas');
  const ctx = canvas.getContext('2d');
  const scoreEl = document.getElementById('snakeScore');
  const gameOverEl = document.getElementById('snakeGameOver');
  const restartBtn = document.getElementById('snakeRestart');

  const box = 16;
  const cols = canvas.width / box;
  const rows = canvas.height / box;

  let snake, direction, nextDirection, food, score, loop, running;

  function resetGame() {
    snake = [{ x: 8, y: 8 }];
    direction = 'right';
    nextDirection = 'right';
    score = 0;
    scoreEl.textContent = score;
    gameOverEl.style.display = 'none';
    placeFood();
    running = true;
    if (loop) clearInterval(loop);
    loop = setInterval(tick, 120);
  }

  function placeFood() {
    food = {
      x: Math.floor(Math.random() * cols),
      y: Math.floor(Math.random() * rows)
    };
    for (const seg of snake) {
      if (seg.x === food.x && seg.y === food.y) return placeFood();
    }
  }

  function tick() {
    if (!running) return;
    direction = nextDirection;

    const head = { ...snake[0] };
    if (direction === 'up') head.y--;
    if (direction === 'down') head.y++;
    if (direction === 'left') head.x--;
    if (direction === 'right') head.x++;

    if (head.x < 0 || head.x >= cols || head.y < 0 || head.y >= rows) {
      return endGame();
    }
    for (const seg of snake) {
      if (seg.x === head.x && seg.y === head.y) return endGame();
    }

    snake.unshift(head);

    if (head.x === food.x && head.y === food.y) {
      score++;
      scoreEl.textContent = score;
      placeFood();
    } else {
      snake.pop();
    }

    draw();
  }

  function draw() {
    ctx.fillStyle = '#1e293b';
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    ctx.fillStyle = '#f87171';
    ctx.fillRect(food.x * box, food.y * box, box - 1, box - 1);

    snake.forEach((seg, i) => {
      ctx.fillStyle = i === 0 ? '#22c55e' : '#4ade80';
      ctx.fillRect(seg.x * box, seg.y * box, box - 1, box - 1);
    });
  }

  function endGame() {
    running = false;
    clearInterval(loop);
    gameOverEl.style.display = 'block';
  }

  function setDirection(dir) {
    const opposite = { up: 'down', down: 'up', left: 'right', right: 'left' };
    if (opposite[dir] !== direction) nextDirection = dir;
  }

  document.addEventListener('keydown', (e) => {
    if (modal.style.display !== 'flex') return;
    if (e.key === 'ArrowUp') setDirection('up');
    if (e.key === 'ArrowDown') setDirection('down');
    if (e.key === 'ArrowLeft') setDirection('left');
    if (e.key === 'ArrowRight') setDirection('right');
  });

  document.querySelectorAll('.snakeDir').forEach(btn => {
    btn.addEventListener('click', () => setDirection(btn.dataset.dir));
  });

  let touchStartX = 0, touchStartY = 0;
  canvas.addEventListener('touchstart', (e) => {
    touchStartX = e.touches[0].clientX;
    touchStartY = e.touches[0].clientY;
  });
  canvas.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - touchStartX;
    const dy = e.changedTouches[0].clientY - touchStartY;
    if (Math.abs(dx) > Math.abs(dy)) {
      setDirection(dx > 0 ? 'right' : 'left');
    } else {
      setDirection(dy > 0 ? 'down' : 'up');
    }
  });

  restartBtn.addEventListener('click', resetGame);

  openBtn.addEventListener('click', () => {
    modal.style.display = 'flex';
    resetGame();
  });

  closeBtn.addEventListener('click', () => {
    modal.style.display = 'none';
    running = false;
    clearInterval(loop);
  });

  modal.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal.style.display = 'none';
      running = false;
      clearInterval(loop);
    }
  });
})();
</script>


