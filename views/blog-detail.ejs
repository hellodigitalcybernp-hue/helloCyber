<section class="section" style="padding-bottom:0;">
  <div class="container">
    <a href="/blog" class="filter-pill" style="display:inline-flex; margin-bottom:20px;">
      <%- icon('arrow-left') %> Back to Blog
    </a>

    <div class="section-head" style="text-align:left; max-width:800px; margin:0;">
      <span class="badge-category"><%= article.category %></span>
      <h1 style="margin-top:12px;"><%= article.title %></h1>
      <p><%= article.excerpt %></p>

      <div class="service-meta" style="margin-top:16px; gap:16px; display:flex; flex-wrap:wrap;">
        <span><%- icon('clock') %> <%= new Date(article.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></span>
        <% if (article.author) { %>
          <span><%- icon('user') %> <%= article.author %></span>
        <% } %>
        <% if (article.readTime) { %>
          <span><%- icon('book-open') %> <%= article.readTime %> min read</span>
        <% } %>
      </div>
    </div>
  </div>
</section>

<section class="section" style="padding-top:24px;">
  <div class="container" style="max-width:800px;">

    <% if (article.coverImage) { %>
      <img src="<%= article.coverImage %>" alt="<%= article.title %>"
           style="width:100%; max-height:420px; object-fit:cover; border-radius:14px; margin-bottom:28px;" />
    <% } %>

    <article class="a-content" style="background:#fff; border:1px solid #E3E9F0; border-radius:14px; padding:36px; line-height:1.8;">
      <%- article.content %>
    </article>

    <% if (article.tags && article.tags.length) { %>
      <div class="filter-row" style="justify-content:flex-start; margin-top:24px;">
        <% article.tags.forEach(function(tag){ %>
          <span class="filter-pill"><%- icon('tag') %> <%= tag %></span>
        <% }) %>
      </div>
    <% } %>

    <%- include('partials/ad-slot') %>

    <% if (related && related.length) { %>
      <div class="section-head" style="text-align:left; margin-top:48px;">
        <h2>Related Articles</h2>
      </div>
      <div class="service-grid">
        <% related.forEach(function(a){ %>
          <a href="/blog/<%= a.slug %>" class="service-card" style="text-decoration:none; color:inherit;">
            <span class="badge-category"><%= a.category %></span>
            <% if (a.coverImage) { %>
              <img src="<%= a.coverImage %>" alt="<%= a.title %>" style="width:100%; height:150px; object-fit:cover; border-radius:10px; margin-bottom:14px;" />
            <% } else { %>
              <div class="service-icon"><%- icon('file-text') %></div>
            <% } %>
            <h3><%= a.title %></h3>
            <p class="desc"><%= a.excerpt %></p>
            <div class="service-meta">
              <span><%- icon('clock') %> <%= new Date(a.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></span>
            </div>
          </a>
        <% }) %>
      </div>
    <% } %>

  </div>
</section>