<section class="section">
  <div class="container" style="max-width:820px;">
    <div class="section-head" style="max-width:100%;">
      <span class="eyebrow"><%- icon('users') %> About Us</span>
      <h1>Who We Are</h1>
      <p><%= settings.aboutText %></p>
    </div>

    <div class="steps" style="margin-bottom:56px;">
      <div class="step">
        <div class="service-icon" style="margin-bottom:14px;"><%- icon('shield') %></div>
        <h3>Accuracy First</h3>
        <p>Every form is double-checked before it leaves our counter, so it isn't rejected for a simple mistake.</p>
      </div>
      <div class="step">
        <div class="service-icon" style="margin-bottom:14px;"><%- icon('clock') %></div>
        <h3>Fast Turnaround</h3>
        <p>Most requests are completed the same day — because your time matters as much as your documents.</p>
      </div>
      <div class="step">
        <div class="service-icon" style="margin-bottom:14px;"><%- icon('message') %></div>
        <h3>Honest Guidance</h3>
        <p>Not sure what you need? We'll tell you plainly, even if it means a smaller job for us.</p>
      </div>
    </div>

    <div class="cta-band">
      <div>
        <h2>Ready to get your documents sorted?</h2>
        <p>Browse our services or reach out directly — we're happy to help.</p>
      </div>
      <a href="/services" class="btn btn-primary">View Services</a>
    </div>
  </div>
</section>
