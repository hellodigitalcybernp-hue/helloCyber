<div class="a-card" style="max-width:520px;">
  <div class="a-card-head"><h3>My Account</h3></div>
  <form action="/admin/account?_method=PUT" method="POST">
    <div class="a-form-group">
      <label for="name">Display Name</label>
      <input type="text" id="name" name="name" value="<%= admin.name %>" required />
    </div>
    <div class="a-form-group">
      <label for="username">Username</label>
      <input type="text" id="username" name="username" value="<%= admin.username %>" required />
    </div>
    <div class="a-form-group">
      <label for="newPassword">New Password</label>
      <input type="password" id="newPassword" name="newPassword" placeholder="Leave blank to keep current password" />
    </div>
    <button type="submit" class="a-btn a-btn-primary"><%- icon('check') %> Save Changes</button>
  </form>
</div>
