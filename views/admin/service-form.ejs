<div class="a-card">
  <form
    action="<%= service ? '/admin/services/' + service._id + '?_method=PUT' : '/admin/services' %>"
    method="POST"
    enctype="multipart/form-data"
  >
    <div class="a-form-grid">
      <div class="a-form-group">
        <label for="title">Service Title</label>
        <input type="text" id="title" name="title" required value="<%= service ? service.title : '' %>" placeholder="e.g. Passport Application Form Fill-up" />
      </div>
      <div class="a-form-group">
        <label for="category">Category</label>
        <input type="text" id="category" name="category" list="categoryList" value="<%= service ? service.category : 'General' %>" />
        <datalist id="categoryList">
          <option value="Documents">
          <option value="Government">
          <option value="Digital Services">
          <option value="General">
        </datalist>
      </div>

     <div class="a-form-group">
  <label for="icon">Choose Icon</label>
  <select id="icon" name="icon">
    <option value="">-- Upload Custom Icon --</option>
    <% iconList().forEach(function(i){ %>
      <option value="<%= i %>" <%= (service && service.icon === i) ? 'selected' : '' %>>
        <%= i %>
      </option>
    <% }) %>
  </select>

  <div class="a-help">
    Select an icon from the list or upload your own image below.
  </div>
</div>

<div class="a-form-group">
  <label for="iconImage">Custom Icon Image</label>
  <input
    type="file"
    id="iconImage"
    name="iconImage"
    accept=".png,.jpg,.jpeg,.svg,.webp"
  />

  <% if(service && service.iconImage){ %>
    <div style="margin-top:10px;">
      <img
        src="<%= service.iconImage %>"
        style="width:60px;height:60px;object-fit:contain;border:1px solid #ddd;padding:5px;border-radius:8px;"
      >
    </div>
     <% } %>

    <div class="a-help">
    Recommended size: 64×64 or SVG with transparent background.
     </div>
    </div>
      <div class="a-form-group">
        <label for="duration">Estimated Duration</label>
        <input type="text" id="duration" name="duration" value="<%= service ? service.duration : '' %>" placeholder="e.g. Same day / 1-2 working days" />
      </div>

      <div class="a-form-group">
        <label for="price">Price (Rupee)</label>
        <input type="number" min="0" step="1" id="price" name="price" value="<%= service ? service.price : 0 %>" />
      </div>
      <div class="a-form-group">
        <label for="priceNote">Price Note</label>
        <input type="text" id="priceNote" name="priceNote" value="<%= service ? service.priceNote : '' %>" placeholder="e.g. starting from / govt fee separate" />
      </div>

      <div class="a-form-group full">
        <label for="shortDescription">Short Description (shown on cards)</label>
        <input type="text" id="shortDescription" name="shortDescription" required value="<%= service ? service.shortDescription : '' %>" />
      </div>

      <div class="a-form-group full">
        <label for="fullDescription">Full Description (shown on the service page)</label>
        <textarea id="fullDescription" name="fullDescription" rows="4"><%= service ? service.fullDescription : '' %></textarea>
      </div>

      <div class="a-form-group full">
        <label for="requirements">Requirements Checklist (one per line)</label>
        <textarea id="requirements" name="requirements" rows="4" placeholder="NID copy&#10;Birth certificate&#10;Passport size photo"><%= service && service.requirements ? service.requirements.join('\n') : '' %></textarea>
      </div>

      <div class="a-form-group full">
        <label for="order">Display Order (lower shows first)</label>
        <input type="number" id="order" name="order" value="<%= service ? service.order : 0 %>" style="max-width:160px;" />
      </div>

      <div class="a-form-group full">
        <label for="image">Service Image (optional)</label>
        <input type="file" id="image" name="image" accept="image/*" />
        <% if (service && service.image) { %>
          <img src="<%= service.image %>" class="a-thumb" style="width:70px; height:70px; margin-top:10px;" alt="" />
        <% } %>
      </div>

      <div class="a-form-group">
        <div class="a-checkbox-row">
          <input type="checkbox" id="active" name="active" <%= (!service || service.active) ? 'checked' : '' %> />
          <label for="active" style="margin:0;">Active (visible on website)</label>
        </div>
      </div>
      <div class="a-form-group">
        <div class="a-checkbox-row">
          <input type="checkbox" id="featured" name="featured" <%= (service && service.featured) ? 'checked' : '' %> />
          <label for="featured" style="margin:0;">Featured on homepage</label>
        </div>
      </div>
    </div>

    <div style="display:flex; gap:10px; margin-top:10px;">
      <button type="submit" class="a-btn a-btn-primary"><%- icon('check') %> <%= service ? 'Save Changes' : 'Add Service' %></button>
      <a href="/admin/services" class="a-btn a-btn-ghost">Cancel</a>
    </div>
  </form>
</div>
