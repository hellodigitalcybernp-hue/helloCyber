<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/x-icon" href="/image/favicon.ico">
 <link rel="icon" type="image/png" sizes="32x32" href="/image/logo.png">
 <link rel="apple-touch-icon" href="/image/apple-touch-icon.png">
  <title><%= title %> - Admin - HelloDigitalCyber</title>
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body>
  <div class="admin-shell">
    <aside class="a-sidebar" id="aSidebar">
      <div>
        <div class="a-brand">
  <img src="/image/hellocyber.png" alt="HelloDigitalCyber Logo" class="a-logo">
  <span>HelloDigitalCyber</span>
</div>
        <div class="a-nav-label">General</div>
        <a href="/admin/dashboard" class="a-nav-item <%= currentPath === '/admin/dashboard' ? 'active' : '' %>"><%- icon('home') %> Dashboard</a>
        <div class="a-nav-label">Manage</div>
        <a href="/admin/services" class="a-nav-item <%= currentPath.startsWith('/admin/services') ? 'active' : '' %>"><%- icon('layers') %> Services</a>
        <a href="/admin/messages" class="a-nav-item <%= currentPath.startsWith('/admin/messages') ? 'active' : '' %>"><%- icon('inbox') %> Requests &amp; Messages</a>
<a href="/admin/chat" class="a-nav-item <%= currentPath.startsWith('/admin/chat') ? 'active' : '' %>"><%- icon('message') %> Live Chat</a>
        <div class="a-nav-label">Site</div>
        <a href="/admin/settings" class="a-nav-item <%= currentPath.startsWith('/admin/settings') ? 'active' : '' %>"><%- icon('settings') %> Site Settings</a>
        <a href="/admin/account" class="a-nav-item <%= currentPath.startsWith('/admin/account') ? 'active' : '' %>"><%- icon('users') %> My Account</a>
        <a href="/" target="_blank" class="a-nav-item"><%- icon('grid') %> View Website</a>
      </div>
      <div class="a-sidebar-footer">
        <div class="a-user">
          <div class="a-user-avatar"><%= (adminName || 'A').charAt(0).toUpperCase() %></div>
          <div>
            <div class="a-user-name"><%= adminName || 'Admin' %></div>
            <div class="a-user-role">Administrator</div>
          </div>
        </div>
        <form action="/admin/logout" method="POST">
          <button type="submit" class="a-logout-btn"><%- icon('log-out') %> Log Out</button>
        </form>
      </div>
    </aside>

    <main class="a-main">
      <div class="a-topbar">
        <h1><%= title %></h1>
      </div>
      <div class="a-content">
        <% if (success && success.length) { %>
          <% success.forEach(function(m){ %><div class="a-alert a-alert-success"><%= m %></div><% }) %>
        <% } %>
        <% if (error && error.length) { %>
          <% error.forEach(function(m){ %><div class="a-alert a-alert-error"><%= m %></div><% }) %>
        <% } %>
        <%- body %>
      </div>
    </main>
  </div>
</body>
</html>
