<div class="a-card" style="padding:0; overflow:hidden;">
  <div style="display:flex; height:600px;">

    <!-- Conversation list -->
    <div id="ac-list" style="width:280px; border-right:1px solid #EEF1F6; overflow-y:auto;">
      <div class="a-card-head" style="padding:14px 16px; margin:0;">
        <h3 style="margin:0; font-size:1rem;">Conversations</h3>
      </div>
      <% conversations.forEach(function(c) { %>
        <div class="ac-conv-item <%= String(c._id) === String(activeConversationId) ? 'active' : '' %>"
             data-id="<%= c._id %>">
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <b style="font-size:0.9rem;"><%= c.visitorName || 'Visitor' %></b>
            <% if (c.unreadByAdmin) { %><span class="ac-dot"></span><% } %>
          </div>
          <div style="font-size:0.78rem; color:#8592a6;"><%= c.visitorPhone || '' %></div>
          <div style="font-size:0.75rem; color:#B2BAC7; margin-top:2px;">
            <%= new Date(c.lastMessageAt).toLocaleString() %>
          </div>
        </div>
      <% }) %>
      <% if (conversations.length === 0) { %>
        <div class="a-empty" style="padding:20px;">No conversations yet.</div>
      <% } %>
    </div>

    <!-- Active conversation -->
    <div style="flex:1; display:flex; flex-direction:column;">
      <div class="a-card-head" style="padding:14px 16px; margin:0; border-bottom:1px solid #EEF1F6;">
        <h3 id="ac-active-name" style="margin:0; font-size:1rem;">Select a conversation</h3>
        <button id="ac-close-btn" class="btn" style="display:none; font-size:0.8rem;">Mark closed</button>
      </div>
      <div id="ac-messages" style="flex:1; overflow-y:auto; padding:16px; display:flex; flex-direction:column; gap:8px;"></div>
      <form id="ac-form" style="display:flex; gap:8px; padding:12px; border-top:1px solid #EEF1F6;">
        <input id="ac-input" type="text" placeholder="Type a reply..." autocomplete="off"
               style="flex:1; padding:9px 12px; border:1px solid #D8DEE8; border-radius:8px; font-size:0.9rem;" />
        <button type="submit" class="btn btn-primary" style="padding:9px 16px;">Send</button>
      </form>
    </div>
  </div>
</div>

<style>
  .ac-conv-item { padding:12px 16px; border-bottom:1px solid #F3F5F9; cursor:pointer; }
  .ac-conv-item:hover { background:#F8FAFC; }
  .ac-conv-item.active { background:#EAF6F4; border-left:3px solid #0d9488; }
  .ac-dot { width:8px; height:8px; border-radius:50%; background:#e11d48; display:inline-block; }
  .ac-msg { max-width:75%; padding:8px 12px; border-radius:12px; font-size:0.87rem; line-height:1.35; }
  .ac-msg-visitor { align-self:flex-start; background:#F1F4F8; color:#2b3648; border-bottom-left-radius:3px; }
  .ac-msg-admin { align-self:flex-end; background:#0d9488; color:#fff; border-bottom-right-radius:3px; }
</style>

<script>
(function () {
  const POLL_MS = 4000;
  let activeId = <%- activeConversationId ? JSON.stringify(activeConversationId) : 'null' %>;
  let lastMessageAt = null;
  let pollTimer = null;

  const listEl = document.getElementById('ac-list');
  const messagesEl = document.getElementById('ac-messages');
  const nameEl = document.getElementById('ac-active-name');
  const closeBtn = document.getElementById('ac-close-btn');
  const form = document.getElementById('ac-form');
  const input = document.getElementById('ac-input');

  function renderMessage(m) {
    const div = document.createElement('div');
    div.className = 'ac-msg ' + (m.sender === 'admin' ? 'ac-msg-admin' : 'ac-msg-visitor');
    div.textContent = m.text;
    messagesEl.appendChild(div);
    lastMessageAt = m.createdAt;
  }

  function scrollToBottom() {
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  async function loadConversation(id, name) {
    activeId = id;
    lastMessageAt = null;
    messagesEl.innerHTML = '';
    nameEl.textContent = name || 'Conversation';
    closeBtn.style.display = 'inline-block';

    document.querySelectorAll('.ac-conv-item').forEach((el) => {
      el.classList.toggle('active', el.dataset.id === id);
    });

    await poll();
  }

  async function poll() {
    if (!activeId) return;
    const url = '/admin/chat/' + activeId + '/messages' + (lastMessageAt ? '?after=' + encodeURIComponent(lastMessageAt) : '');
    try {
      const res = await fetch(url);
      const data = await res.json();
      if (data.ok) {
        data.messages.forEach(renderMessage);
        scrollToBottom();
      }
    } catch (err) {
      // retry next tick
    }
  }

  listEl.querySelectorAll('.ac-conv-item').forEach((el) => {
    el.addEventListener('click', () => {
      const name = el.querySelector('b').textContent;
      loadConversation(el.dataset.id, name);
    });
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const text = input.value.trim();
    if (!text || !activeId) return;
    input.value = '';
    const res = await fetch('/admin/chat/' + activeId + '/message', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ text }),
    });
    const data = await res.json();
    if (data.ok) {
      renderMessage(data.message);
      scrollToBottom();
    }
  });

  closeBtn.addEventListener('click', async () => {
    if (!activeId) return;
    await fetch('/admin/chat/' + activeId + '/close', { method: 'POST' });
  });

  if (pollTimer) clearInterval(pollTimer);
  pollTimer = setInterval(poll, POLL_MS);

  // Auto-load the first/active conversation on page load
  if (activeId) {
    const activeEl = document.querySelector('.ac-conv-item.active');
    const name = activeEl ? activeEl.querySelector('b').textContent : '';
    loadConversation(activeId, name);
  }
})();
</script>
